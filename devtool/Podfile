# devtool 플레이버의 Podfile — 루트 Podfile을 LYNX_DEVTOOL=1로 평가한다.
#
# 이 디렉토리에서 pod install을 돌리면 Pods/ · Podfile.lock · 워크스페이스가 전부 여기에
# 생겨, 릴리스 빌드의 루트 Podfile.lock과 앵커 프로젝트를 건드리지 않는다. 앵커 프로젝트
# (Lynx-XcFramework.xcodeproj + Lynx-XcFramework/Anchor.swift)는 scripts/build-devtool.sh가
# 루트에서 복사해 둔다(git-ignored). 직접 pod install을 돌릴 일은 없고, 스크립트를 쓴다.
#
# Lynx 버전, pod 목록, post_install은 루트 Podfile 한 곳에만 있다 — 여기에 pod을 더하지 말 것.
ENV['LYNX_DEVTOOL'] = '1'

root_podfile = File.expand_path('../Podfile', __dir__)
eval(File.read(root_podfile), binding, root_podfile)
